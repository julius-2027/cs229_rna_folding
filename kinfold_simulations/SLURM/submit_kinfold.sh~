#!/bin/bash
#SBATCH --job-name=kinfold_fpts
#SBATCH --array=0-8626           # adjust to nrows-1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=24:00:00          # adjust after testing one sequence
#SBATCH --output=logs/kinfold_%A_%a.out
#SBATCH --error=logs/kinfold_%A_%a.err

INPUT_PARQUET="features.parquet"
OUTDIR="fpt_results"

mkdir -p logs

# make sure to run beforehand: conda activate viennarna

python run_kinfold.py --index $SLURM_ARRAY_TASK_ID --input $INPUT_PARQUET --outdir $OUTDIR
